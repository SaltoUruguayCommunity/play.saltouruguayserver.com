# New, dedicated SaltoPlay database. Never use the main website database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saltoplay
PUBLIC_APP_URL=http://localhost:4321
SUS_ISSUER=https://saltouruguayserver.com
SUS_CLIENT_ID=
SUS_CLIENT_SECRET=
# Register PUBLIC_APP_URL/auth/callback as an exact SaltoUruguayServer callback.
# Optional local admin override by verified SaltoUruguayServer subject (not email).
# Normally leave empty: is_admin is inherited from verified OAuth userinfo at sign-in.
ADMIN_SUS_SUBJECTS=
# Hosted runtime must be a different origin from the portal.
# For the included local example, run pnpm run runtime in another terminal.
PUBLIC_HOSTED_DEMO_ORIGIN=http://127.0.0.1:4322
SUS_ONETAP=true
# Production: *.hosted-games.play.saltouruguayserver.com points to this Vercel project.
# Keep portal cookies host-only; the game wildcard must not include the portal host.
HOSTED_BASE_DOMAIN=hosted-games.play.saltouruguayserver.com
# Local development only: persistent storage for the optional Node processes.
HOSTED_STORAGE_PATH=
HOSTED_PORT=4322
HOSTED_BIND=127.0.0.1

# Public-read object storage. Upload/delete still require server credentials.
S3_BUCKET=saltouruguay-web
S3_REGION=us-east-1
S3_ENDPOINT=https://b505118f5ebfee108383689c7fba3970.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional namespace within a shared bucket, for example saltoplay/
S3_PREFIX=saltoplay/
# Public HTTPS bucket/CDN base already mapping S3_PREFIX, for example https://cdn.example.com/saltoplay/
S3_PUBLIC_URL=https://cdn.saltouruguayserver.com/saltoplay/
# Shared by the portal and isolated runtime; at least 32 random characters.
HOSTED_PREVIEW_SECRET=
# HTTPS image CDN base mapping S3_PREFIX, for example https://cdn.example.com/saltoplay/
# Optional image-specific override. Defaults to S3_PUBLIC_URL.
MEDIA_CDN_URL=

# External HTTP cron: GET /api/internal/hosted-jobs with Authorization: Bearer <secret>.
# Generate a private random value of at least 32 characters; never put it in the URL.
CRON_SECRET=
