---
import { ArrowUpRight, Play, ExternalLink } from '@lucide/astro';
import type { Game } from '@/lib/catalog';
interface Props { game: Game; }
const { game } = Astro.props;
---
<a href={`/juegos/${game.slug}`} class="game-card" data-game data-title={game.title.toLowerCase()} data-genre={game.genre}>
  <div class="game-image"><img src={game.cover || '/art/orbita.svg'} alt={`Portada de ${game.title}`} width="640" height="370" loading="lazy" /><span class="badge">{game.type === 'hosted' ? <Play size={10} /> : <ExternalLink size={10} />}{game.type === 'hosted' ? 'JUGÁ EN SALTOPLAY' : 'JUEGO EXTERNO'}</span></div>
  <div class="game-info">{game.icon && <img src={game.icon} alt="" width="36" height="36" loading="lazy" class="size-9 shrink-0 rounded-lg object-cover" />}<div class="min-w-0 flex-1"><h3>{game.title}</h3><p>{game.genre} <span class="px-1">·</span> {game.demo && game.type === 'hosted' ? 'Demo interactiva' : 'Navegador'}</p></div><ArrowUpRight size={17} class="text-[#6c657b]" /></div>
</a>
