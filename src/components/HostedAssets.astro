---
import { db } from '@/db';
import { builds, gameMedia, releases, games } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';
import { mediaUrl } from '@/lib/runtime';
import { Upload, Box, Image, History, ArrowUpRight } from '@lucide/astro';
interface Props { game: typeof games.$inferSelect; canReview?: boolean; }
const { game, canReview = false } = Astro.props;
const [versions, images, history, publishedVersions] = await Promise.all([
 db().select().from(builds).where(eq(builds.gameId, game.id)).orderBy(desc(builds.createdAt)),
 db().select().from(gameMedia).where(eq(gameMedia.gameId, game.id)).orderBy(desc(gameMedia.createdAt)),
 db().select({ release: releases, version: builds.version }).from(releases).innerJoin(builds, eq(builds.id, releases.buildId)).where(eq(releases.gameId, game.id)).orderBy(desc(releases.createdAt)).limit(20),
 db().selectDistinct({ buildId: releases.buildId }).from(releases).where(eq(releases.gameId, game.id)),
]);
const labels: Record<string, string> = { awaiting_upload: 'Subida pendiente', queued: 'En cola', processing: 'Procesando', ready: 'Lista para revisión', review: 'En revisión', approved: 'Aprobada', rejected: 'Rechazada', failed: 'Error' };
const pending = [...versions, ...images].some(row => ['queued', 'processing'].includes(row.status));
const canUpload = game.status !== 'suspended';
const date = (value: Date) => value.toLocaleString('es-UY', { timeZone: 'America/Montevideo', dateStyle: 'short', timeStyle: 'short' });
---
<div class="hosted-console space-y-6" data-hosted-console data-game-id={game.id} data-pending={String(pending)}>
 <p class="notice" data-hosted-feedback role="status" hidden></p>
 <a class="notice block text-violet" data-hosted-refresh href={Astro.url.pathname + Astro.url.search} hidden>El procesamiento terminó. Actualizá para ver los archivos y las acciones disponibles. <ArrowUpRight size={14} class="inline" /></a>
 {game.type === 'hosted' && <section class="panel"><h2 class="mb-3 flex items-center gap-2 text-xl"><Box size={20} class="text-violet" />Versiones del juego</h2><p class="muted mb-6 text-xs leading-6">Subí un ZIP con index.html en la raíz y rutas relativas. Hasta 25 MB comprimidos, 100 MB descomprimidos y 1500 archivos. Subir una versión no reemplaza la publicada.</p>
 <div class="space-y-4">{versions.map(build => <article class="rounded-xl border border-white/10 p-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><h3 class="text-sm font-medium">{build.version} {game.activeBuildId === build.id && <span class="badge badge-violet ml-2">Publicada ahora</span>}</h3><p class="muted mt-2 text-[10px]">{date(build.createdAt)} · {build.fileCount} archivos · {(build.bytes / 1024 / 1024).toFixed(1)} MB</p></div><span class="badge" data-job-id={build.id} data-job-status={build.status}>{labels[build.status]}</span></div>{build.notes && <p class="muted mt-3 whitespace-pre-wrap text-xs leading-6">{build.notes}</p>}{build.error && <p class="mt-3 text-xs text-rose-300">{build.error}</p>}<div class="mt-4 flex flex-wrap gap-2">
 {['ready', 'review', 'approved'].includes(build.status) && <button type="button" class="btn btn-secondary" data-build-action="preview" data-id={build.id}>Vista previa</button>}
 {build.status === 'ready' && <button type="button" class="btn btn-secondary" data-build-action="review" data-id={build.id}>Enviar a revisión</button>}
 {canReview && build.status === 'review' && <><button type="button" class="btn btn-primary" data-build-action="approve" data-id={build.id}>Aprobar versión</button><button type="button" class="btn btn-secondary" data-build-action="reject" data-id={build.id}>Rechazar</button></>}
 {build.status === 'approved' && build.id !== game.activeBuildId && (game.status === 'published' || canReview) && <button type="button" class="btn btn-primary" data-build-action="publish" data-id={build.id} data-confirm="Esta versión se usará en las partidas nuevas. ¿Publicarla?">Publicar versión</button>}
 {build.status === 'approved' && build.id !== game.activeBuildId && publishedVersions.some(h => h.buildId === build.id) && <button type="button" class="btn btn-secondary" data-build-action="rollback" data-id={build.id} data-confirm="Las partidas nuevas usarán esta versión. Los guardados no se restauran. ¿Continuar?">Restaurar versión</button>}
 {build.status === 'failed' && <button type="button" class="btn btn-secondary" data-build-action="retry" data-id={build.id}>Reintentar procesamiento</button>}
 {['awaiting_upload', 'failed'].includes(build.status) && <button type="button" class="btn btn-secondary" data-build-action="discard" data-id={build.id}>Descartar subida</button>}
 </div></article>)}</div>
 {!canReview && <form data-direct-upload data-kind="build" class="mt-6 border-t border-white/10 pt-6"><label class="field">Nombre de versión<input name="version" placeholder="1.0.0" required maxlength="40" disabled={!canUpload} /></label><label class="field">Notas de esta versión<textarea name="notes" maxlength="2000" disabled={!canUpload} placeholder="Qué cambió, correcciones y requisitos de guardados." /></label><label class="field">Paquete ZIP<input type="file" name="file" accept=".zip,application/zip" required disabled={!canUpload} /></label><button class="btn btn-secondary" disabled={!canUpload}><Upload size={15} />Subir nueva versión</button></form>}
 <p class="muted mt-5 text-[10px] leading-6">Las partidas abiertas conservan su versión. Los puntos, logros y guardados no se revierten al hacer rollback.</p>
 </section>}
 <section class="panel"><h2 class="mb-3 flex items-center gap-2 text-xl"><Image size={20} class="text-violet" />Imágenes del juego</h2><p class="muted mb-5 text-xs leading-6">Icono, banner y hasta 8 capturas visibles. PNG, JPG o WebP de hasta 8 MB. Las imágenes se validan y convierten a WebP antes de poder usarlas.</p>
 <div class="grid gap-4 sm:grid-cols-2">{images.map(image => { const url = mediaUrl(game.id, image.id, image.artifactKey); const selected = game.icon === url || game.cover === url || game.screenshots.includes(url); return <article class="rounded-xl border border-white/10 p-3">{image.status === 'ready' ? <img src={url} alt={image.alt || image.kind} loading="lazy" class:list={['mb-3 h-28 w-full rounded-lg bg-black/20', image.kind === 'icon' ? 'object-contain' : 'object-cover']} /> : <span class="badge" data-job-id={image.id} data-job-status={image.status}>{labels[image.status]}</span>}<div class="mt-2 flex items-center justify-between text-xs"><span>{{ icon: 'Icono', banner: 'Banner', screenshot: 'Captura' }[image.kind]}</span>{selected && <span class="text-violet">En uso</span>}</div>{image.error && <p class="mt-2 text-[10px] text-rose-300">{image.error}</p>}{!canReview && <div class="mt-3 flex flex-wrap gap-2">{image.status === 'ready' && !selected && <button type="button" class="btn btn-secondary" data-media-action="select" data-id={image.id}>Usar imagen</button>}{image.status === 'failed' && <button type="button" class="btn btn-secondary" data-media-action="retry" data-id={image.id}>Reintentar</button>}{!['queued', 'processing'].includes(image.status) && <button type="button" class="btn btn-secondary" data-media-action="remove" data-id={image.id} data-confirm="¿Quitar esta imagen del juego?">Quitar</button>}</div>}</article>; })}</div>
 {!canReview && <form data-direct-upload data-kind="media" class="mt-6 border-t border-white/10 pt-6"><label class="field">Tipo de imagen<select name="kind" disabled={!canUpload}><option value="icon">Icono · Cuadrado, mínimo 128 × 128</option><option value="banner">Banner · Recomendado 1920 × 1080</option><option value="screenshot">Captura · Recomendado 1920 × 1080</option></select></label><label class="field">Descripción de la imagen<input name="alt" maxlength="150" disabled={!canUpload} /></label><label class="field">Imágenes<input type="file" name="file" accept="image/png,image/jpeg,image/webp" multiple required disabled={!canUpload} /></label><button class="btn btn-secondary" disabled={!canUpload}><Upload size={15} />Subir imágenes</button></form>}
 </section>
 {game.type === 'hosted' && <details class="panel"><summary class="flex cursor-pointer items-center gap-2 text-sm"><History size={16} />Historial de publicaciones</summary><ol class="mt-5 space-y-3">{history.map(({ release, version }) => <li class="text-xs"><span class="text-violet">{release.action === 'rollback' ? 'Restaurada' : 'Publicada'} {version}</span><span class="muted ml-3">{date(release.createdAt)}</span></li>)}</ol>{!history.length && <p class="muted mt-4 text-xs">Todavía no hay versiones publicadas.</p>}</details>}
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-hosted-console]').forEach(root => {
  const gameId = root.dataset.gameId!;
  const feedback = root.querySelector<HTMLElement>('[data-hosted-feedback]')!;
  const say = (message: string) => { feedback.textContent = message; feedback.hidden = false; };
  async function api(path: string, body: unknown) {
   const response = await fetch('/api/developer/' + gameId + '/' + path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
   const data = await response.json(); if (!response.ok) throw new Error(data.message || 'No pudimos completar la operación.'); return data;
  }
  root.querySelectorAll<HTMLFormElement>('[data-direct-upload]').forEach(form => form.addEventListener('submit', async event => {
   event.preventDefault(); const button = form.querySelector<HTMLButtonElement>('button')!; const values = new FormData(form); const files = values.getAll('file').filter((value): value is File => value instanceof File && value.size > 0);
   if (!files.length) return; button.disabled = true;
   try {
    for (let index = 0; index < files.length; index++) {
     const file = files[index]; const kind = form.dataset.kind === 'build' ? 'build' : String(values.get('kind'));
     if (kind !== 'screenshot' && files.length > 1) throw new Error('Subí un solo icono o banner por vez.');
     if (file.size > (kind === 'build' ? 25 : 8) * 1024 * 1024) throw new Error('El archivo supera el tamaño permitido.');
     say('Subiendo ' + file.name + ' (' + (index + 1) + '/' + files.length + ')…');
     const upload = await api('uploads', { kind, size: file.size, contentType: kind === 'build' ? 'application/zip' : file.type, version: values.get('version') || undefined, notes: values.get('notes') || '', alt: values.get('alt') || '' });
     const target = new URL(upload.url, location.origin);
     const response = await fetch(target, { method: 'PUT', headers: upload.headers, body: file, credentials: target.origin === location.origin ? 'same-origin' : 'omit' });
     if (!response.ok) throw new Error('Falló la subida. Revisá la configuración CORS del almacenamiento e intentá de nuevo.');
     say('Procesando ' + file.name + '…');
     const complete = await api('uploads/complete', { id: upload.id, kind: upload.kind });
     if (complete.status === 'failed') say((complete.error || 'El procesamiento falló.') + ' — ' + file.name);
    }
    location.reload();
   } catch (error) { say(error instanceof Error ? error.message : 'Error de conexión.'); button.disabled = false; }
  }));
  root.querySelectorAll<HTMLButtonElement>('[data-build-action],[data-media-action]').forEach(button => button.addEventListener('click', async () => {
   if (button.dataset.confirm && !confirm(button.dataset.confirm)) return;
   const preview = button.dataset.buildAction === 'preview' ? window.open('about:blank', '_blank') : null;
   if (preview) preview.opener = null;
   button.disabled = true;
   try {
    const result = button.dataset.buildAction ? await api('builds', { action: button.dataset.buildAction, buildId: button.dataset.id }) : await api('media', { action: button.dataset.mediaAction, id: button.dataset.id });
    if (result.url) { if (preview) preview.location.href = result.url; else say('Permití las ventanas emergentes para abrir la vista previa.'); button.disabled = false; } else location.reload();
   } catch (error) { preview?.close(); say(error instanceof Error ? error.message : 'Error de conexión.'); button.disabled = false; }
  }));
  if (root.dataset.pending === 'true') {
   let stopped = false;
   const timer = setInterval(async () => {
    if (stopped || document.hidden) return;
    try { const response = await fetch('/api/developer/' + gameId + '/status'); if (!response.ok) return; const jobs: { id: string; status: string }[] = await response.json();
     let changed = false;
     root.querySelectorAll<HTMLElement>('[data-job-id]').forEach(element => { const job = jobs.find(row => row.id === element.dataset.jobId); if (job && job.status !== element.dataset.jobStatus) { element.dataset.jobStatus = job.status; const labels: Record<string, string> = { queued: 'En cola', processing: 'Procesando', ready: 'Lista', failed: 'Error', review: 'En revisión', approved: 'Aprobada' }; element.textContent = labels[job.status] || job.status; if (!['queued', 'processing'].includes(job.status)) changed = true; } });
     if (changed) root.querySelector<HTMLElement>('[data-hosted-refresh]')!.hidden = false;
     if (!jobs.some(job => ['queued', 'processing'].includes(job.status))) clearInterval(timer);
    } catch { /* Keep the page usable if status is temporarily unavailable. */ }
   }, 4000);
   window.addEventListener('pagehide', () => { stopped = true; clearInterval(timer); }, { once: true });
  }
 });
</script>
