---
import { Copy, ExternalLink, Server, Gamepad2 } from '@lucide/astro';
import { serverStateLabels, safeJoinUrl, type CommunityServer } from '@/lib/community-servers';
interface Props { server: CommunityServer; }
const { server } = Astro.props;
const joinUrl = server.joinUrl && safeJoinUrl(server.joinUrl) ? server.joinUrl : null;
const webLink = joinUrl?.startsWith('https:');
---
<article class="server-card" data-server-card>
  {server.cover && <img class="server-cover" src={server.cover} alt="" width="640" height="220" loading="lazy" />}
  <div class="server-card-body">
    <div class="flex items-start justify-between gap-4"><div class="server-game-icon"><Server size={21} /></div><span class:list={['server-state', `server-state-${server.state}`]}>{serverStateLabels[server.state]}</span></div>
    <div class="mt-5 flex flex-wrap items-center gap-2 text-[10px] text-[#a899bd]"><Gamepad2 size={13} />{server.game}{server.version && <><span aria-hidden="true">·</span>{server.version}</>}</div>
    <h3 class="mt-2 text-xl font-medium tracking-tight">{server.title}</h3>
    <p class="muted mt-3 text-xs leading-6">{server.description}</p>
    {server.accessNote && <p class="mt-4 text-[10px] text-[#b8aacb]">{server.accessNote}</p>}
    <div class="server-card-actions">
      {server.address && <div class="server-address"><code>{server.address}</code><button type="button" data-copy-ip={server.address} aria-label={`Copiar dirección de ${server.title}`}><Copy size={14} /><span data-copy-label>Copiar IP</span></button></div>}
      {joinUrl && <a class="btn btn-secondary" href={joinUrl} target={webLink ? '_blank' : undefined} rel={webLink ? 'noopener noreferrer' : undefined}>{server.joinLabel}<ExternalLink size={14} /></a>}
    </div>
    <p class="server-copy-status" data-copy-status role="status" hidden></p>
  </div>
</article>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-ip]').forEach(button => button.addEventListener('click', async () => {
    const address = button.dataset.copyIp;
    const status = button.closest('[data-server-card]')?.querySelector<HTMLElement>('[data-copy-status]');
    if (!address || !status) return;
    button.disabled = true;
    try { await navigator.clipboard.writeText(address); status.textContent = 'Dirección copiada. Pegala en tu juego para conectarte.'; }
    catch { status.textContent = `No pudimos copiarla automáticamente. Copiá esta dirección: ${address}`; }
    finally { status.hidden = false; button.disabled = false; }
  }));
</script>
