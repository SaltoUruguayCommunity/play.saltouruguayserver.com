---
import Layout from '@/layouts/Layout.astro';
import Avatar from '@/components/Avatar.astro';
import { db, databaseConfigured } from '@/db';
import { players } from '@/db/schema';
import { and, eq } from 'drizzle-orm';
import { getPlayerProgress } from '@/lib/player-progress';
if (!databaseConfigured()) return Astro.redirect('/404');
const [player] = await db().select({ id: players.id, displayName: players.displayName, avatar: players.avatar, tag: players.tag, bio: players.bio, xp: players.xp }).from(players).where(and(eq(players.tag, Astro.params.tag!.toLowerCase()), eq(players.publicProfile, true)));
if (!player) return Astro.redirect('/404');
const progress = await getPlayerProgress(player.id);
---
<Layout title={player.tag}><div class="panel p-10"><Avatar src={player.avatar} name={player.displayName} size={80} square class="mb-6" /><div class="eyebrow mb-4">Jugador de SaltoUruguayServer</div><h1 class="page-title">{player.displayName}</h1><p class="mt-3 text-violet">{player.tag}</p><p class="muted mt-7 max-w-lg text-sm leading-8">{player.bio || 'Cada partida es una nueva historia.'}</p><span class="badge badge-violet mt-7">{progress.score.toLocaleString('es-UY')} SaltoScore</span></div></Layout>
