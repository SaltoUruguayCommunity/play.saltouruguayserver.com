---
import Layout from '@/layouts/Layout.astro';
import { admin } from '@/lib/security';
import { db } from '@/db';
import { games, players, builds } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';
if (!Astro.locals.player || !admin(Astro.locals.player)) return Astro.redirect('/404');
const allGames = await db().select({ game: games, owner: players.displayName }).from(games).innerJoin(players, eq(players.id, games.ownerId)).orderBy(desc(games.updatedAt));
const allBuilds = await db().select().from(builds).orderBy(desc(builds.createdAt));
---
<Layout title="Administración"><div class="eyebrow mb-3">Control de publicación</div><h1 class="page-title">Cuidemos el universo.</h1><p class="muted mb-8 text-xs">Revisá juegos y distribuciones antes de hacerlos públicos.</p>{Astro.url.searchParams.has('saved') && <p class="notice mb-5">Estado actualizado.</p>}<a href="/admin/servidores" class="btn btn-secondary mb-6">Gestionar servidores y series →</a><div class="space-y-5">{allGames.length ? allGames.map(({game, owner}) => <section class="panel"><div class="flex items-center justify-between"><div><h2 class="text-xl">{game.title}</h2><p class="muted mt-2 text-xs">{owner} · {game.type} · {game.slug}</p></div><span class="badge badge-violet">{game.status}</span></div><p class="muted my-5 text-xs leading-7">{game.description}</p>{game.url && <a href={game.url} class="text-xs text-violet" target="_blank" rel="noopener noreferrer">Sitio del juego ↗</a>}<form action="/api/admin/review" method="post" class="mt-5 flex flex-wrap items-end gap-3"><input type="hidden" name="gameId" value={game.id} />{game.type === 'hosted' && <label class="field mb-0 min-w-56">Distribución a publicar<select name="buildId" required>{allBuilds.filter(b => b.gameId === game.id && ['review', 'published'].includes(b.status)).map(b => <option value={b.id}>{b.id.slice(0, 8)} · {b.fileCount} archivos · {b.status}</option>)}</select></label>}<button class="btn btn-primary" name="decision" value="publish" disabled={game.status !== 'review' && game.status !== 'published'}>Aprobar y publicar</button><button class="btn btn-secondary" name="decision" value="draft" disabled={game.status === 'draft'}>Devolver a borrador</button><button class="btn btn-secondary" name="decision" value="suspend" disabled={game.status === 'suspended'}>Suspender</button></form></section>) : <div class="panel empty"><h2>No hay juegos para revisar.</h2><p>Los proyectos aparecerán acá cuando un desarrollador los registre.</p></div>}</div></Layout>
