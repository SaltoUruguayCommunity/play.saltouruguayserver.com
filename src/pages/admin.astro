---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { admin } from '@/lib/security';
import { db } from '@/db';
import { games, players, builds } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';
if (!Astro.locals.player || !admin(Astro.locals.player)) return Astro.redirect('/404');
const status = Astro.url.searchParams.get('status') || 'all';
const q = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const rows = await db().select({ game: games, owner: players.displayName, prodVersion: builds.version, prodStatus: builds.status }).from(games).innerJoin(players, eq(players.id, games.ownerId)).leftJoin(builds, eq(builds.id, games.activeBuildId)).orderBy(desc(games.updatedAt));
const counts = { all: rows.length, review: rows.filter(r => r.game.status === 'review').length, published: rows.filter(r => r.game.status === 'published').length, draft: rows.filter(r => r.game.status === 'draft').length, suspended: rows.filter(r => r.game.status === 'suspended').length };
const filtered = rows.filter(r => (status === 'all' || r.game.status === status) && (!q || r.game.title.toLowerCase().includes(q) || r.game.slug.toLowerCase().includes(q) || r.owner.toLowerCase().includes(q)));
const labels: Record<string, string> = { draft: 'Borrador', review: 'En revisión', published: 'Publicado', suspended: 'Suspendido' };
const tabs = [{id:'all',text:'Todos'},{id:'review',text:'En revisión'},{id:'published',text:'Publicados'},{id:'draft',text:'Borradores'},{id:'suspended',text:'Suspendidos'}];
const qs = (s: string) => "/admin?status=" + s + (q ? "&q=" + encodeURIComponent(q) : "");
---
<AdminLayout title="Administración" pending={counts.review}>
  <p class="eyebrow">Admin · Juegos</p>
  <h1 class="page-title mt-2">Cola de revisión</h1>
  <p class="muted mb-2 text-xs leading-6">El admin aprueba juegos. La versión en producción la elige siempre el desarrollador.</p>
  {Astro.url.searchParams.has('saved') && <p class="notice mb-5" role="status">Estado actualizado.</p>}
  <nav class="admin-tabs" aria-label="Filtrar por estado">{tabs.map(t => <a href={qs(t.id)} class:list={{active: status===t.id}} aria-current={status===t.id?'page':undefined}>{t.text} ({counts[t.id as keyof typeof counts]})</a>)}</nav>
  <form method="get" class="mb-4 flex gap-2" role="search"><input type="hidden" name="status" value={status} /><input name="q" value={q} placeholder="Buscar por título, slug o desarrollador…" class="field" style="margin:0;flex:1" /><button class="btn btn-secondary">Buscar</button></form>
  {filtered.length ? <div class="admin-card" style="padding:0;overflow:auto"><table class="admin-table"><thead><tr><th>Juego</th><th>Tipo</th><th>Versión elegida (dev)</th><th>Estado</th><th>Actualizado</th><th></th></tr></thead><tbody>
    {filtered.map(({game, owner, prodVersion}) => <tr><td><a href={`/admin/juegos/${game.id}`} style="font-weight:600;color:#fff">{game.title}</a><div class="muted" style="font-size:11px;margin-top:2px">{owner} · <span class="mono">/{game.slug}</span></div></td><td>{game.type === 'hosted' ? 'Hosted' : 'Externo'}</td><td class="mono">{prodVersion ? 'v' + prodVersion : '—'}</td><td><span class:list={['status', 'status-' + game.status]}>{labels[game.status]}</span></td><td class="muted" style="font-size:12px">{new Date(game.updatedAt).toLocaleDateString('es-UY')}</td><td><a class="btn btn-secondary" style="padding:7px 12px" href={`/admin/juegos/${game.id}`}>Revisar →</a></td></tr>)}
  </tbody></table></div> : <div class="admin-card empty"><h2>Sin resultados.</h2><p>No hay juegos con este filtro.</p></div>}
</AdminLayout>
