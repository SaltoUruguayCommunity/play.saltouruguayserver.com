---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { listServers, serverStateLabels } from "@/lib/community-servers";
import { admin } from "@/lib/security";
if (!Astro.locals.player || !admin(Astro.locals.player)) return Astro.redirect("/404");
const servers = await listServers(true);
const pending = 0;
---
<AdminLayout title="Administrar servidores" pending={pending}><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="eyebrow">Admin · Servidores</p><h1 class="page-title mt-2">Servidores y series</h1><p class="muted mt-2 text-xs leading-6">Configurá qué está activo y cómo entrar. Los estados son editoriales, no salud en tiempo real.</p></div><a href="/admin/servidores/nuevo" class="btn btn-primary">Agregar serie</a></div>
{Astro.url.searchParams.has('saved') && <p class="notice mt-4" role="status">Cambios guardados.</p>}
<div class="admin-card mt-6" style="padding:0;overflow:auto"><table class="admin-table"><thead><tr><th>Serie</th><th>Juego</th><th>Estado</th><th>Visibilidad</th><th>Orden</th><th></th></tr></thead><tbody>{servers.map(s => <tr><td><strong style="color:#fff">{s.title}</strong><div class="muted mono mt-1 text-[11px]">{s.address || s.joinUrl || '—'}</div></td><td>{s.game}</td><td><span class="status status-review">{serverStateLabels[s.state]}</span></td><td>{s.visible ? 'Visible' : 'Oculta'}</td><td class="mono">{s.position}</td><td><a class="btn btn-secondary" style="padding:7px 12px" href={`/admin/servidores/${s.id}`}>Editar →</a></td></tr>)}</tbody></table></div></AdminLayout>
