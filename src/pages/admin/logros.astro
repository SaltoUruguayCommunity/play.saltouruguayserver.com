---
import Layout from '@/layouts/Layout.astro';
import { db } from '@/db';
import { achievements, games } from '@/db/schema';
import { admin } from '@/lib/security';
import { eq, asc } from 'drizzle-orm';
if (!Astro.locals.player || !admin(Astro.locals.player)) return Astro.redirect('/404');
const rows = await db().select({ achievement: achievements, game: games }).from(achievements).innerJoin(games, eq(games.id, achievements.gameId)).orderBy(asc(games.title), asc(achievements.title));
---
<Layout title="Logros y SaltoScore"><a href="/admin" class="text-xs text-violet">← Administración</a><h1 class="page-title mt-6">Logros y SaltoScore</h1><p class="muted mb-7 max-w-2xl text-xs leading-7">SaltoUruguayServer verifica los logros que otorgan puntos. Los juegos no pueden asignar SaltoScore desde el navegador. Los cambios de valor solo afectan a concesiones futuras; los puntos ganados se conservan.</p>
{Astro.url.searchParams.has('saved') && <p class="notice mb-6" role="status">Cambios guardados. Si el logro ya tenía puntos, no se volvieron a otorgar.</p>}
<div class="space-y-5">{rows.map(({ achievement: a, game }) => <section class="panel"><span class="eyebrow">{game.title}</span><h2 class="mt-3 text-xl">{a.title}</h2><p class="muted mt-2 text-xs leading-6">{a.description}</p><form method="post" action="/api/admin/achievements" class="mt-5 flex flex-wrap items-end gap-4"><input type="hidden" name="action" value="configure" /><input type="hidden" name="achievementId" value={a.id} /><label class="field mb-0">SaltoScore por logro<input name="score" type="number" min="0" max="1000" step="1" value={a.score} required /></label><label class="flex items-center gap-2 py-3 text-xs"><input type="checkbox" name="verified" checked={a.verified} />Requiere verificación de SaltoUruguayServer</label><button class="btn btn-secondary">Guardar valor</button></form>
{a.verified && a.score > 0 && game.status === 'published' && <form method="post" action="/api/admin/achievements" class="mt-6 flex flex-wrap items-end gap-3 border-t border-white/10 pt-5"><input type="hidden" name="action" value="award" /><input type="hidden" name="achievementId" value={a.id} /><label class="field mb-0">Otorgar a un SaltoTag<input name="tag" required pattern="[a-zA-Z0-9_-]{3,30}" minlength="3" maxlength="30" placeholder="saltotag del jugador" /></label><button class="btn btn-primary">Verificar y otorgar {a.score} puntos</button></form>}</section>)}
{!rows.length && <div class="panel empty"><h2>Todavía no hay logros.</h2><p>Los logros de los juegos aparecerán acá para su revisión.</p></div>}</div></Layout>
