---
import Layout from '@/layouts/Layout.astro';
import { ArrowLeft, Plus } from '@lucide/astro';
if (!Astro.locals.player) return Astro.redirect('/acceso?returnTo=/developers/nuevo');
---
<Layout title="Crear un juego"><a class="mb-6 inline-flex items-center gap-2 text-xs text-violet" href="/developers"><ArrowLeft size={14} />Consola de desarrollo</a><h1 class="page-title">El comienzo de algo nuevo.</h1><p class="muted mb-8 text-xs">Primero la idea. Después, el resto del universo.</p><div class="two-col"><form class="panel" method="post" action="/api/developer/games"><label class="field">Nombre del juego<input name="title" required maxlength="80" placeholder="Tu próxima gran idea" /></label><p class="muted mb-5 text-xs leading-6">El identificador público se genera automáticamente a partir del nombre. Si ya está ocupado, añadimos un sufijo aleatorio para que la dirección sea única.</p><label class="field">Descripción<textarea name="description" required minlength="20" maxlength="3000" placeholder="Contanos qué hace especial a tu juego…"></textarea></label><label class="field">Categoría<select name="genre">{['Arcade', 'Cartas', 'Casual', 'Aventura', 'Puzzle', 'Estrategia', 'Multijugador'].map(g => <option>{g}</option>)}</select></label><label class="field">Distribución<select name="type"><option value="hosted">Hosted — Subir una distribución web</option><option value="external">External — Ya tengo un sitio</option></select></label><button class="btn btn-primary" type="submit"><Plus />Crear borrador</button><p id="form-error" role="alert" class="mt-4 text-xs text-rose-300" hidden></p></form><aside class="panel h-fit"><span class="badge badge-violet">DEVELOPMENT FIRST</span><h2 class="mt-5 text-lg">Un espacio para experimentar.</h2><p class="muted mt-3 text-xs leading-7">Tu juego empieza como borrador privado. Podés configurar la integración y sus logros antes de enviarlo a revisión.</p><a href="/docs/hosted" class="mt-5 inline-block text-xs text-violet">Conocer el hosting y el bridge →</a></aside></div></Layout>
<script>document.querySelector('form.panel')?.addEventListener('submit', async e => { e.preventDefault(); const form = e.currentTarget as HTMLFormElement; const button = form.querySelector('button')!; button.disabled = true; const error = document.getElementById('form-error')!; try { const endpoint = form.getAttribute('action'); if (!endpoint) throw new Error('El formulario no tiene un destino configurado.'); const response = await fetch(endpoint, { method: 'POST', body: new FormData(form) }); const data = await response.json(); if (!response.ok) throw new Error(data.message || 'No pudimos crear el juego.'); location.assign(`/developers/${data.id}`); } catch (err) { error.textContent = err instanceof Error ? err.message : 'Error de conexión'; error.hidden = false; button.disabled = false; } });</script>
