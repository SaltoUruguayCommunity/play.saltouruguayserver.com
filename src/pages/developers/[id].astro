---
import Layout from "@/layouts/Layout.astro";
import HostedAssets from "@/components/HostedAssets.astro";
import { db } from "@/db";
import { games, achievements, clients, gameMedia } from "@/db/schema";
import { and, eq } from "drizzle-orm";
import { z } from "zod";
import { ArrowLeft, Send, KeyRound, Trophy } from "@lucide/astro";
import { canEditGameMetadata } from "@/lib/game-status";
import { mediaUrl } from "@/lib/runtime";
const player = Astro.locals.player;
if (!player) return Astro.redirect("/acceso?returnTo=/developers");
const id = z.uuid().safeParse(Astro.params.id);
if (!id.success) return Astro.redirect("/404");
const [game] = await db()
  .select()
  .from(games)
  .where(and(eq(games.id, id.data), eq(games.ownerId, player.id)));
if (!game) return Astro.redirect("/404");
const [gameAchievements, gameClients] = await Promise.all([
  db().select({ achievement: achievements, image: gameMedia }).from(achievements).leftJoin(gameMedia, eq(gameMedia.id, achievements.imageId)).where(eq(achievements.gameId, game.id)),
  db()
    .select({
      id: clients.id,
      name: clients.name,
      redirectUris: clients.redirectUris,
      secretHash: clients.secretHash,
    })
    .from(clients)
    .where(eq(clients.gameId, game.id)),
]);
const editable = canEditGameMetadata(game.status);
---

<Layout title={`${game.title} · Consola`}
  ><a
    href="/developers"
    class="mb-6 inline-flex items-center gap-2 text-xs text-violet"
    ><ArrowLeft size={14} />Mis juegos</a
  ><div class="mb-7 flex flex-wrap items-center justify-between gap-4">
    <div>
      <span class="eyebrow">Consola del juego · {game.type}</span><h1
        class="page-title mt-3"
      >
        {game.title}
      </h1>
    </div><span class="badge badge-violet"
      >{
        {
          draft: "Borrador privado",
          review: "En revisión",
          published: "Publicado",
          suspended: "Suspendido",
        }[game.status]
      }</span>
  </div><div id="feedback" class="notice mb-6" role="status" hidden></div><div
    id="credentials"
    class="panel mb-6"
    hidden
  >
    <h2 class="text-lg">Guardá tus credenciales.</h2><p
      class="muted my-3 text-xs"
    >
      El secreto sólo se muestra una vez. Usalo únicamente en tu servidor.
    </p><pre id="credential-value"></pre>
  </div><div class="two-col">
    <div class="space-y-6">
      <form
        class="panel api-form"
        method="post"
        action={`/api/developer/${game.id}`}
      >
        <h2 class="mb-6 text-xl">Acerca del juego</h2><input
          type="hidden"
          name="action"
          value="update"
        /><label class="field"
          >Nombre<input
            name="title"
            value={game.title}
            required
            minlength="2"
            maxlength="80"
            disabled={!editable}
          /></label
        ><label class="field"
          >Descripción<textarea
            name="description"
            required
            minlength="20"
            maxlength="3000"
            disabled={!editable}>{game.description}</textarea
          ></label
        >{
          game.type === "external" && (
            <label class="field">
              Dirección del juego
              <input
                name="url"
                type="url"
                value={game.url || ""}
                placeholder="https://tu-juego.com"
                required
                disabled={!editable}
              />
            </label>
          )
        }<button class="btn btn-primary" disabled={!editable}
          >Guardar cambios</button>
      </form>
      <HostedAssets game={game} />
      <section class="panel" id="achievements" data-game-id={game.id}>
        <div class="mb-5 flex items-center gap-3">
          <Trophy class="text-violet" size={20} /><h2 class="text-xl">
            Logros
          </h2>
        </div>{
          gameAchievements.length ? (
            gameAchievements.map(({ achievement: a, image }) => (
              <div
                class="mb-4 border-b border-white/5 pb-4"
                data-achievement-row
                data-achievement-id={a.id}
              >
                <div class="flex items-center gap-4">
                  <span class="grid size-14 shrink-0 place-items-center overflow-hidden rounded-xl border border-white/10 bg-[#171525]">
                    {image ? (
                      <img
                        src={mediaUrl(game.id, image.id, image.artifactKey)}
                        alt=""
                        width="56"
                        height="56"
                        class="size-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <Trophy size={22} class="text-[#8d819f]" />
                    )}
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-sm">{a.title}</h3>
                    <span class="muted font-mono text-[10px]">{a.key}</span>
                    <p class="muted mt-1 text-[11px] leading-5">{a.description}</p>
                  </div>
                  <span class="badge ml-auto shrink-0">
                    {a.verified
                      ? a.score + " SaltoScore"
                      : "Casual · Sin puntos"}
                  </span>
                </div>
                <div class="mt-3 flex flex-wrap items-center gap-2 pl-[72px]">
                  <button type="button" class="btn btn-secondary" data-achievement-edit disabled={!editable}>Editar</button>
                  <button type="button" class="btn btn-secondary" data-achievement-image-upload disabled={!editable}>{image ? "Reemplazar imagen" : "Subir imagen"}</button>
                  {image && <button type="button" class="btn btn-secondary" data-achievement-image-remove data-id={image.id} disabled={!editable}>Quitar imagen</button>}
                  <form class="api-form inline" method="post" action={`/api/developer/${game.id}`} data-confirm="¿Eliminar este logro? Sólo es posible si nadie lo desbloqueó todavía.">
                    <input type="hidden" name="action" value="achievement_delete" />
                    <input type="hidden" name="achievementId" value={a.id} />
                    <button type="submit" class="btn btn-secondary" disabled={!editable}>Eliminar</button>
                  </form>
                  <input type="file" accept="image/png,image/jpeg,image/webp" class="hidden" data-achievement-file disabled={!editable} />
                </div>
                <form class="api-form achievement-edit-form mt-3 hidden pl-[72px]" method="post" action={`/api/developer/${game.id}`}>
                  <input type="hidden" name="action" value="achievement_update" />
                  <input type="hidden" name="achievementId" value={a.id} />
                  <label class="field">Nombre<input name="title" value={a.title} required maxlength="80" disabled={!editable} /></label>
                  <label class="field">Descripción<input name="description" value={a.description} required maxlength="300" disabled={!editable} /></label>
                  <button class="btn btn-primary" type="submit" disabled={!editable}>Guardar cambios</button>
                </form>
              </div>
            ))
          ) : (
            <p class="muted mb-5 text-xs">
              Definí el primer desafío de tu juego.
            </p>
          )
        }<form
          class="api-form mt-5"
          method="post"
          action={`/api/developer/${game.id}`}
        >
          <input type="hidden" name="action" value="achievement" /><label
            class="field"
            >Clave<input
              name="key"
              placeholder="first-win"
              pattern="[a-z0-9-]{2,80}"
              required
              disabled={!editable}
            /></label
          ><label class="field"
            >Nombre<input
              name="title"
              placeholder="La primera victoria"
              required
              maxlength="80"
              disabled={!editable}
            /></label
          ><label class="field"
            >Descripción<input
              name="description"
              placeholder="Ganaste tu primera partida."
              required
              maxlength="300"
              disabled={!editable}
            /></label
          ><button class="btn btn-secondary" disabled={!editable}
            >Crear logro casual</button>
        </form><p class="muted mt-4 text-[10px] leading-6">
          Los logros declarados por el navegador no otorgan XP global. Los
          logros verificados requieren una política de validación de servidor.
        </p>
      </section>
      <section class="panel">
        <div class="mb-5 flex items-center gap-3">
          <KeyRound class="text-violet" size={20} /><h2 class="text-xl">
            Clientes OAuth
          </h2>
        </div>{
          gameClients.map((client) => (
            <div class="mb-4 rounded-lg border border-white/10 p-4">
              <>
                <h3 class="text-sm">
                  {client.name}{" "}
                  <span class="muted text-[10px]">
                    · {client.secretHash ? "Confidencial" : "Público"}
                  </span>
                </h3>
                <p class="mt-2 break-all font-mono text-[10px] text-violet">
                  {client.id}
                </p>
                <p class="muted mt-2 break-all text-[10px]">
                  {client.redirectUris.join(", ")}
                </p>
              </>
            </div>
          ))
        }<form
          class="api-form mt-5"
          method="post"
          action={`/api/developer/${game.id}`}
        >
          <input type="hidden" name="action" value="client" /><label
            class="field"
            >Nombre del cliente<input
              name="name"
              placeholder="Mi juego · Producción"
              required
              maxlength="80"
            /></label
          ><label class="field"
            >Callback exacto<input
              name="redirectUri"
              type="url"
              placeholder="https://tu-juego.com/callback"
              required
            /></label
          ><label class="field"
            >Tipo<select name="kind"
              ><option value="public">Público — Navegador / móvil (PKCE)</option
              ><option value="confidential"
                >Confidencial — Backend con secreto</option
              ></select
            ></label
          ><button class="btn btn-secondary">Crear cliente OAuth</button>
        </form>
      </section>
    </div><aside class="space-y-5">
      <div class="panel">
        <h2 class="text-lg">Publicación</h2><p
          class="muted my-4 text-xs leading-7"
        >
          {
            editable
              ? "Elegí qué versión va a producción desde Versiones. Cuando esté listo, envialo a revisión: el administrador aprueba el juego, no cada versión."
              : "La ficha está bloqueada, pero podés subir versiones nuevas y poner en producción la que elijas sin retirar el juego."
          }
        </p><form
          class="api-form"
          action={`/api/developer/${game.id}`}
          method="post"
        >
          <input type="hidden" name="action" value="review" /><button
            class="btn btn-primary w-full"
            disabled={!editable}><Send size={15} />Enviar a revisión</button>
        </form>
      </div><div class="panel">
        <span class="eyebrow">Integración</span><h2 class="mt-4 text-lg">
          Hacé la conexión.
        </h2><p class="muted my-4 text-xs leading-7">
          Usá el SDK para conectar la identidad del jugador y conservar el
          progreso.
        </p><a
          href={game.type === "hosted" ? "/docs/hosted" : "/docs/oauth"}
          class="text-xs text-violet">Guía de integración →</a>
      </div>
    </aside>
  </div></Layout
>
<script>
  document.querySelectorAll<HTMLFormElement>(".api-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (form.dataset.confirm && !window.confirm(form.dataset.confirm)) return;
      const button = form.querySelector("button")!;
      const feedback = document.getElementById("feedback")!;
      button.disabled = true;
      feedback.hidden = true;
      try {
        // A control named "action" shadows form.action with an HTMLInputElement.
        const endpoint = form.getAttribute("action");
        if (!endpoint)
          throw new Error("El formulario no tiene un destino configurado.");
        const response = await fetch(endpoint, {
          method: "POST",
          body: new FormData(form),
        });
        if (
          !response.headers.get("content-type")?.includes("application/json")
        ) {
          throw new Error(
            "No pudimos procesar la solicitud. Recargá la página e intentá de nuevo.",
          );
        }
        const data = await response.json();
        if (!response.ok) throw new Error(data.message || data.error);
        if (data.secret) {
          document.getElementById("credentials")!.hidden = false;
          document.getElementById("credential-value")!.textContent =
            `Client ID: ${data.clientId}\nClient secret: ${data.secret}`;
          feedback.textContent =
            "Cliente creado. Copiá el secreto antes de salir de esta página.";
          feedback.hidden = false;
          button.disabled = false;
        } else {
          location.reload();
        }
      } catch (error) {
        feedback.textContent =
          error instanceof Error ? error.message : "Error de conexión";
        feedback.hidden = false;
        feedback.scrollIntoView({ block: "center" });
        button.disabled = false;
      }
    });
  });
  const achievementSection = document.getElementById('achievements');
  const achievementGameId = achievementSection?.dataset.gameId;
  const say = (message: string) => { const feedback = document.getElementById('feedback') as HTMLElement | null; if (feedback) { feedback.textContent = message; feedback.hidden = false; } };
  const postJson = async (path: string, body: unknown) => {
    const response = await fetch('/api/developer/' + achievementGameId + '/' + path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await response.json();
    if (!response.ok) throw new Error(data.message || data.error || 'No pudimos completar la operación.');
    return data;
  };
  achievementSection?.querySelectorAll<HTMLButtonElement>('[data-achievement-edit]').forEach((button) => button.addEventListener('click', () => {
    button.closest('[data-achievement-row]')?.querySelector('.achievement-edit-form')?.classList.toggle('hidden');
  }));
  achievementSection?.querySelectorAll<HTMLButtonElement>('[data-achievement-image-upload]').forEach((button) => button.addEventListener('click', () => {
    button.closest('[data-achievement-row]')?.querySelector<HTMLInputElement>('[data-achievement-file]')?.click();
  }));
  achievementSection?.querySelectorAll<HTMLInputElement>('[data-achievement-file]').forEach((input) => input.addEventListener('change', async () => {
    const file = input.files?.[0]; if (!file || !achievementGameId) return;
    const row = input.closest('[data-achievement-row]') as HTMLElement | null;
    const achievementId = row?.dataset.achievementId; if (!achievementId) return;
    if (file.size > 8 * 1024 * 1024) { say('La imagen supera los 8 MB permitidos.'); return; }
    if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) { say('Usá una imagen PNG, JPG o WebP.'); return; }
    try {
      say('Subiendo imagen…');
      const upload = await postJson('uploads', { kind: 'achievement', achievementId, size: file.size, contentType: file.type, alt: '' });
      const target = new URL(upload.url, location.origin);
      const response = await fetch(target, { method: 'PUT', headers: upload.headers, body: file, credentials: target.origin === location.origin ? 'same-origin' : 'omit' });
      if (!response.ok) throw new Error('Falló la subida. Revisá la configuración CORS del almacenamiento.');
      const complete = await postJson('uploads/complete', { id: upload.id, kind: 'media' });
      if (complete.status === 'failed') say(complete.error || 'El procesamiento falló.');
      else location.reload();
    } catch (error) { say(error instanceof Error ? error.message : 'No pudimos subir la imagen.'); }
    finally { input.value = ''; }
  }));
  achievementSection?.querySelectorAll<HTMLButtonElement>('[data-achievement-image-remove]').forEach((button) => button.addEventListener('click', async () => {
    if (!window.confirm('¿Quitar la imagen de este logro?')) return;
    try { await postJson('media', { action: 'remove', id: button.dataset.id }); location.reload(); }
    catch (error) { say(error instanceof Error ? error.message : 'No pudimos quitar la imagen.'); }
  }));
</script>
