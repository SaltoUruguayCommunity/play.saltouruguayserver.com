---
import Layout from '@/layouts/Layout.astro';
import { CodeXml, ArrowUpRight, Plus, Box, KeyRound, Trophy, HardDrive, ChevronRight } from '@lucide/astro';
import { db } from '@/db';
import { games } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';
const player = Astro.locals.player;
const owned = player ? await db().select().from(games).where(eq(games.ownerId, player.id)).orderBy(desc(games.createdAt)) : [];
---
<Layout title="Desarrolladores"><div class="eyebrow mb-3">SaltoPlay Developers</div><div class="flex flex-wrap items-center justify-between gap-5"><div><h1 class="page-title">Tu idea merece ser jugada.</h1><p class="muted text-xs">Todo lo que necesitás para conectar tu juego con una comunidad.</p></div><a class="btn btn-primary" href="/developers/nuevo"><Plus />Crear un juego</a></div>
{player ? <><div class="section-head"><h2>Tus juegos</h2><span class="badge">{owned.length} proyectos</span></div>{owned.length ? <div class="space-y-3">{owned.map(game => <a href={`/developers/${game.id}`} class="panel flex items-center gap-4"><div class="feature-icon m-0"><Box /></div><div><h3 class="text-base">{game.title}</h3><p class="muted mt-1 text-xs">{game.type} · /{game.slug}</p></div><span class="badge badge-violet ml-auto">{{ draft: 'Borrador', review: 'En revisión', published: 'Publicado', suspended: 'Suspendido' }[game.status]}</span><ChevronRight size={16} /></a>)}</div> : <div class="panel empty"><CodeXml /><h2 class="text-xl">Tu primer proyecto empieza acá.</h2><p>Registrá un juego, definí sus permisos y probá la integración antes de enviarlo a revisión.</p><a class="btn btn-primary" href="/developers/nuevo">Crear mi primer juego</a></div>}</> : <section class="banner my-8 min-h-52"><div><span class="eyebrow text-violet">Menos infraestructura. Más juego.</span><h2 class="mt-4 max-w-xl font-display text-3xl tracking-tight">Creá la experiencia.<br />Conectate con una sola integración.</h2><p class="muted mt-4 max-w-lg text-xs leading-6">Alojá tu juego web en SaltoPlay o integrá uno externo. Una cuenta SaltoUruguayServer te da acceso a la consola de desarrollo.</p></div><a href="/acceso?returnTo=/developers" class="btn btn-primary shrink-0">Ingresar a la consola <ArrowUpRight /></a></section>}
<div class="section-head"><h2>Un SDK. Muchas posibilidades.</h2><a href="/docs" class="text-xs text-violet">Leer documentación →</a></div><div class="grid gap-4 sm:grid-cols-2">{[{ icon: KeyRound, title: 'Identidad sin fricción', text: 'Acceso con SaltoUruguayServer para juegos externos y sesión integrada mediante bridge para juegos hosted.' }, { icon: Trophy, title: 'Logros que cuentan historias', text: 'Definí desafíos con claves estables y registrá sus desbloqueos de forma idempotente.' }, { icon: HardDrive, title: 'Progreso que acompaña', text: 'Guardados por jugador y juego, con control de versiones para evitar sobrescrituras.' }, { icon: Box, title: 'Tu juego, alojado acá', text: 'Distribuciones web estáticas, versiones aisladas y publicación revisada desde la consola.' }].map(({icon: Icon, title, text}) => <div class="panel"><div class="feature-icon"><Icon /></div><h3 class="mb-3 text-base">{title}</h3><p class="muted text-xs leading-6">{text}</p></div>)}</div><pre class="mt-7"><code>{`const play = await SaltoPlay.init();\nconst player = await play.player.getSaltoTag();\nawait play.saves.set('slot-1', { level: 3 });\nawait play.achievements.requestUnlock('first-win');`}</code></pre></Layout>
