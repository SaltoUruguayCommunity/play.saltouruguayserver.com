---
import Layout from '@/layouts/Layout.astro';
import { db } from '@/db';
import { grants, games } from '@/db/schema';
import { eq } from 'drizzle-orm';
import { canChangeSaltoTag, nextSaltoTagChange, formatSaltoTagDate, SALTOTAG_CHANGE_INTERVAL_DAYS } from '@/lib/saltotag';
const player = Astro.locals.player;
if (!player) return Astro.redirect('/acceso?returnTo=/ajustes');
const tagEditable = canChangeSaltoTag(player.tagChangedAt);
const nextTagChange = nextSaltoTagChange(player.tagChangedAt);
const profileErrors: Record<string, string> = { tag_cooldown: 'Todavía no podés cambiar tu SaltoTag. Revisá la fecha indicada debajo.', tag_taken: 'Ese SaltoTag ya está en uso. Elegí otro.', invalid_profile: 'No pudimos guardar los cambios. Revisá los datos y volvé a intentarlo.' };
const profileError = profileErrors[Astro.url.searchParams.get('error') || ''];
const connections = await db().select({ grant: grants, game: games }).from(grants).innerJoin(games, eq(games.id, grants.gameId)).where(eq(grants.playerId, player.id));
---
<Layout title="Ajustes"><h1 class="page-title">A tu manera.</h1><p class="muted mb-8 text-xs">Tu identidad y tus permisos, bajo tu control.</p>{Astro.url.searchParams.has('saved') && <p class="notice mb-6" role="status">Perfil actualizado.</p>}{profileError && <p class="notice mb-6" role="alert">{profileError}</p>}<div class="two-col"><div><form method="post" action="/api/profile" class="panel"><h2 class="mb-6 text-xl">Perfil de jugador</h2><label class="field">SaltoTag<input name="tag" value={player.tag} readonly={!tagEditable} aria-describedby="tag-change-policy" required pattern="[a-zA-Z0-9_-]{3,30}" maxlength="30" minlength="3" /><span class="text-[10px] muted">Entre 3 y 30 letras, números, guiones o guiones bajos. Único en SaltoPlay.</span><span id="tag-change-policy" class="text-[11px] leading-6 text-violet">{!tagEditable && nextTagChange ? 'Podés volver a cambiarlo el ' + formatSaltoTagDate(nextTagChange) + ' (hora de Uruguay).' : player.tagChangedAt ? 'Podés cambiarlo ahora. El próximo cambio estará disponible en ' + SALTOTAG_CHANGE_INTERVAL_DAYS + ' días.' : 'Elegí tu primer SaltoTag cuando quieras. Después podrás cambiarlo cada ' + SALTOTAG_CHANGE_INTERVAL_DAYS + ' días.'}</span></label><label class="field">Sobre vos<textarea name="bio" maxlength="300">{player.bio}</textarea></label><label class="mb-6 flex items-center gap-3 text-xs"><input type="checkbox" name="publicProfile" checked={player.publicProfile} />Permitir que otros vean mi perfil</label><button class="btn btn-primary">Guardar cambios</button></form><section class="panel mt-6"><h2 class="mb-5 text-xl">Juegos conectados</h2>{connections.length ? connections.map(({grant, game}) => <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/5 py-4"><div><h3>{game.title}</h3><p class="muted mt-2 text-[10px]">{grant.scopes.join(', ')}</p></div><form method="post" action="/api/revoke"><input type="hidden" name="gameId" value={game.id} /><button class="btn btn-secondary">Revocar acceso</button></form></div>) : <p class="muted text-xs">Todavía no autorizaste ningún juego.</p>}</section></div><aside class="panel h-fit"><h2 class="text-lg">Tu cuenta SaltoUruguayServer</h2><p class="muted mt-4 text-xs leading-7">Tu nombre y avatar vienen de SaltoUruguayServer. Tu SaltoTag y tu progreso se gestionan acá.</p><a href="https://saltouruguayserver.com/configuracion" class="mt-5 block text-xs text-violet">Gestionar cuenta SaltoUruguayServer ↗</a><form method="post" action="/auth/logout" class="mt-6 border-t border-white/5 pt-6"><button class="btn btn-secondary w-full">Cerrar sesión en SaltoPlay</button></form></aside></div></Layout>
