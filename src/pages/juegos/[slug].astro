---
import Layout from '@/layouts/Layout.astro';
import { findGame } from '@/lib/catalog';
import { db, databaseConfigured } from '@/db';
import { achievements, library } from '@/db/schema';
import { and, eq } from 'drizzle-orm';
import { Play, ArrowLeft, Trophy, ExternalLink, Plus, Check, ShieldCheck } from '@lucide/astro';
const game = await findGame(Astro.params.slug!);
if (!game) return Astro.redirect('/404');
const list = !game.demo && databaseConfigured() ? await db().select().from(achievements).where(eq(achievements.gameId, game.id)) : [];
const player = Astro.locals.player;
const saved = player && !game.demo ? (await db().select().from(library).where(and(eq(library.playerId, player.id), eq(library.gameId, game.id))).limit(1)).length > 0 : false;
---
<Layout title={game.title}><a href="/juegos" class="mb-6 inline-flex items-center gap-2 text-xs text-[#9b90af]"><ArrowLeft size={14} />Todos los juegos</a><div class="overflow-hidden rounded-2xl border border-white/5"><img src={game.cover || '/art/orbita.svg'} class="max-h-[430px] w-full object-cover" alt={`Portada de ${game.title}`} width="1200" height="500" /></div><div class="two-col mt-8"><section><div class="mb-4 flex gap-2"><span class="badge badge-violet">{game.genre}</span><span class="badge">{game.type === 'hosted' ? 'Hosted · Navegador' : 'Juego externo'}</span>{game.demo && <span class="badge">Vista de demostración</span>}</div><h1 class="page-title">{game.title}</h1><p class="muted mt-5 max-w-2xl text-sm leading-8">{game.description}</p><div class="section-head"><h2>Logros del juego</h2><Trophy size={19} class="text-violet" /></div>{list.length ? <div class="space-y-3">{list.map(a => <div class="panel flex items-center gap-4"><div class="feature-icon m-0"><Trophy /></div><div><h3 class="text-sm">{a.title}</h3><p class="muted mt-1 text-xs">{a.description}</p></div><span class="ml-auto badge">{a.verified ? `${a.xp} XP` : 'Casual'}</span></div>)}</div> : <div class="panel"><p class="muted text-xs leading-6">{game.demo ? 'Esta muestra no concede logros ni XP al perfil. Órbita permite probar el bridge sin una cuenta.' : 'El desarrollador todavía no publicó logros para este juego.'}</p></div>}</section><aside><div class="panel"><div class="mb-5 flex items-center gap-2 text-xs text-[#ada4bd]"><ShieldCheck size={17} class="text-violet" />{game.type === 'hosted' ? 'Jugá desde tu navegador' : 'Disponible en la web del juego'}</div><a href={`/jugar/${game.slug}`} class="btn btn-primary w-full"><Play fill="currentColor" />{game.type === 'hosted' ? 'Jugar ahora' : 'Abrir juego'}{game.type === 'external' && <ExternalLink />}</a>{!game.demo && <form method="post" action="/api/library" class="mt-3"><input type="hidden" name="gameId" value={game.id} /><input type="hidden" name="returnTo" value={Astro.url.pathname} /><button class="btn btn-secondary w-full" disabled={saved}>{saved ? <Check /> : <Plus />}{saved ? 'En tu biblioteca' : 'Agregar a mi biblioteca'}</button></form>}<p class="muted mt-5 text-[11px] leading-6">{game.type === 'hosted' ? 'Los juegos alojados se ejecutan en un espacio aislado. Vos elegís los permisos que compartís.' : 'Se abrirá el sitio del juego. La sesión y sus condiciones se gestionan allí.'}</p></div><a href="/docs/jugadores" class="mt-5 block text-center text-[11px] text-[#8e819f]">Cómo funciona SaltoPlay →</a></aside></div></Layout>
